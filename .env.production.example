# Copy to .env.production on the host that runs Artemis. Never commit that file.
POSTGRES_DB=artemis
POSTGRES_USER=artemis
POSTGRES_PASSWORD=replace-with-a-long-random-password
WEB_PORT=8080
WHATSAPP_AGENT_TOKEN=replace-with-the-agent-api-token
WHATSAPP_AGENT_NAME=primary
ARTEMIS_ADMIN_TOKEN=replace-with-a-long-random-operator-token
ARTEMIS_CONFIG_ENCRYPTION_KEY=replace-with-a-fernet-key
# Keep blank when configuring Seerr through the control plane.
SEERR_BASE_URL=
SEERR_API_KEY=
# Keep blank when configuring Karakeep through the control plane.
KARAKEEP_BASE_URL=
KARAKEEP_API_KEY=

# Independent shared secret for application webhook ingestion.
ARTEMIS_WEBHOOK_TOKEN=

# Optional: choose a known WhatsApp participant when multiple conversations exist.
# Empty uses the only known participant, if there is exactly one.
ARTEMIS_WEBHOOK_WHATSAPP_RECIPIENT=

# Cola de Codex (el trabajador local se instala con scripts/install-codex-worker.sh).
ARTEMIS_CODEX_STATE_DIR=/var/lib/artemis-codex

# Trabajador Antigravity con escritura sobre el proyecto real.
ARTEMIS_ANTIGRAVITY_STATE_DIR=/var/lib/artemis-antigravity
