# Copy to .env.production on the host that runs Artemis. Never commit that file.
POSTGRES_DB=artemis
POSTGRES_USER=artemis
POSTGRES_PASSWORD=replace-with-a-long-random-password
WEB_PORT=8080
WHATSAPP_AGENT_TOKEN=replace-with-the-agent-api-token
WHATSAPP_AGENT_NAME=primary
ARTEMIS_ADMIN_TOKEN=replace-with-a-long-random-operator-token
ARTEMIS_CONFIG_ENCRYPTION_KEY=replace-with-a-fernet-key
# Keep blank when configuring Seerr through the control plane.
SEERR_BASE_URL=
SEERR_API_KEY=
# Keep blank when configuring Karakeep through the control plane.
KARAKEEP_BASE_URL=
KARAKEEP_API_KEY=
