#!/usr/bin/env python3
import json
import os
import subprocess
import sys

prompt = json.load(sys.stdin)["prompt"]
schema = {
    "type": "object",
    "properties": {key: {"type": "string"} for key in ("reply", "capability", "command")},
    "required": ["reply", "capability", "command"],
    "additionalProperties": False,
}
with subprocess.Popen([
    "/cli/agy/agy", "--effort", "low", "--sandbox", "--disable-slash-commands",
    "--settings", '{"permissions":{"allow":[],"deny":["*"]}}',
    "--output-format", "json", "--json-schema", json.dumps(schema), "--print=" + prompt,
], stdout=subprocess.PIPE, env={**os.environ, "HOME": "/state/agy"}) as process:
    assert process.stdout is not None
    output = process.stdout.read(65537)
    if len(output) > 65536:
        process.kill()
        raise ValueError("AGY response exceeded limit")
    answer = json.loads(output)
    if process.wait() != 0 or answer["status"] != "SUCCESS":
        raise ValueError("AGY request failed")
    print(json.dumps(answer["structured_output"]))
