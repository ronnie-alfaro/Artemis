#!/usr/bin/env python3
import json
import os
import subprocess
import sys
import tempfile
from pathlib import Path

prompt = json.load(sys.stdin)["prompt"]
with tempfile.TemporaryDirectory(prefix="codex-") as directory:
    schema = Path(directory, "schema.json")
    output = Path(directory, "answer.json")
    schema.write_text(json.dumps({
        "type": "object",
        "properties": {key: {"type": "string"} for key in ("reply", "capability", "command")},
        "required": ["reply", "capability", "command"],
        "additionalProperties": False,
    }))
    with subprocess.Popen([
        "/cli/codex/codex", "exec", "--ignore-user-config", "--skip-git-repo-check",
        "--json", "--ephemeral", "-s", "read-only", "-c", 'approval_policy="never"',
        "-c", "features.shell_tool=false", "--output-schema", str(schema),
        "--output-last-message", str(output), "-",
    ], stdin=subprocess.PIPE, stdout=subprocess.PIPE,
        env={**os.environ, "CODEX_HOME": "/state/codex"}) as process:
        from threading import Thread

        def write_prompt():
            assert process.stdin is not None
            try:
                with process.stdin:
                    process.stdin.write(prompt.encode())
            except BrokenPipeError:
                pass

        writer = Thread(target=write_prompt)
        writer.start()
        assert process.stdout is not None
        usage = None
        while line := process.stdout.readline(131073):
            if len(line) > 131072:
                process.kill()
                raise ValueError("Codex event exceeded limit")
            try:
                event = json.loads(line)
            except ValueError:
                continue
            if isinstance(event, dict) and event.get("type") == "turn.completed":
                candidate = event.get("usage")
                if isinstance(candidate, dict) and all(
                    type(candidate.get(key)) is int and candidate[key] >= 0
                    for key in ("input_tokens", "output_tokens")
                ):
                    usage = {
                        key: candidate[key] for key in
                        ("input_tokens", "output_tokens", "cached_input_tokens")
                        if type(candidate.get(key)) is int and candidate[key] >= 0
                    }
        writer.join()
        if process.wait():
            raise ValueError("Codex request failed")
    if output.stat().st_size > 65536:
        raise ValueError("Codex response exceeded limit")
    print(json.dumps({"decision": json.loads(output.read_text()), "usage": usage}))
