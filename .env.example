ARTEMIS_LOG_LEVEL=INFO
POSTGRES_DB=artemis
POSTGRES_USER=artemis
POSTGRES_PASSWORD=change-me-before-production
WEB_PORT=8080
# Configure Seerr in the control plane after startup, or set both values here.
SEERR_BASE_URL=
SEERR_API_KEY=
# Required if saving Seerr credentials through the control plane.
ARTEMIS_CONFIG_ENCRYPTION_KEY=
# Optional WhatsApp Third-Party Agent. Create the agent in WhatsApp first, then
# inject its key through a secret manager in production. Leaving this empty keeps
# the poller disabled.
WHATSAPP_AGENT_TOKEN=
WHATSAPP_AGENT_NAME=primary
