ARTEMIS_LOG_LEVEL=INFO
POSTGRES_DB=artemis
POSTGRES_USER=artemis
POSTGRES_PASSWORD=change-me-before-production
WEB_PORT=8080
# Configure Seerr in the control plane after startup, or set both values here.
SEERR_BASE_URL=
SEERR_API_KEY=
# Required if saving Seerr credentials through the control plane.
ARTEMIS_CONFIG_ENCRYPTION_KEY=
# Optional WhatsApp Third-Party Agent. Create the agent in WhatsApp first, then
# inject its key through a secret manager in production. Leaving this empty keeps
# the poller disabled.
WHATSAPP_AGENT_TOKEN=
WHATSAPP_AGENT_NAME=primary

# Shared bearer token for incoming webhooks. Empty disables event ingestion.
ARTEMIS_WEBHOOK_TOKEN=

# Optional: choose a known WhatsApp participant when multiple conversations exist.
# Empty uses the only known participant, if there is exactly one.
ARTEMIS_WEBHOOK_WHATSAPP_RECIPIENT=

# Cola de Codex (el trabajador local se instala con scripts/install-codex-worker.sh).
ARTEMIS_CODEX_STATE_DIR=/var/lib/artemis-codex

# Trabajador Antigravity con escritura sobre el proyecto real.
ARTEMIS_ANTIGRAVITY_STATE_DIR=/var/lib/artemis-antigravity

# Telegram: bot token and comma-separated authorized numeric user IDs
TELEGRAM_BOT_TOKEN=
TELEGRAM_ALLOWED_USER_IDS=

# KMS envelope encryption (one symmetric customer-managed key).
# AWS credentials are supplied by an IAM role or a read-only SDK profile mount.
ARTEMIS_KMS_KEY_ID=
AWS_REGION=
# Only for docker-compose.kms.yml: directory with AWS config and credentials files.
ARTEMIS_AWS_CONFIG_DIR=
AWS_PROFILE=artemis
